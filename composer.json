{
    "name": "slothsoft/cron",
    "description": "A Farah module that handles cronjobs.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^7.4",
        "krakjoe/pthreads-polyfill": "^1.1.0",
        "slothsoft/core": "^1.14.21",
        "slothsoft/farah": "^1.27.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.3"
    },
    "suggest": {
        "ext-pthreads": "*"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Cron\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Cron\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-cron/",
    "config": {
        "platform": {
            "php": "7.4"
        }
    }
}
