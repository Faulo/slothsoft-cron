{
    "name": "slothsoft/cron",
    "description": "A Farah module that handles cronjobs.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "slothsoft/core": "^1.16.2",
        "slothsoft/farah": "^1.30.0",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.7",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.14"
    },
    "conflict": {
        "symfony/polyfill-php83": ">=1.28.0 <1.30.0"
    },
    "suggest": {
        "ext-parallel": "Enables native work scheduling on thread-safe PHP CLI builds."
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Cron\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Cron\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "homepage": "http://farah.slothsoft.net/modules/cron",
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
