# DDEV manages its FPM service separately. The ZTS CLI takes precedence on PATH.
COPY --from=cron-php-zts /usr/local/bin/php /usr/local/bin/php
COPY --from=cron-php-zts /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=cron-php-zts /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
RUN php --ri parallel
